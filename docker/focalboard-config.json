{
  "serverRoot": "http://localhost:8200",
  "port": 8000,
  "dbtype": "postgres",
  "dbconfig": "postgres://focalboard:test_secret@127.0.0.1:5432/focalboard?sslmode=disable",
  "useSSL": false,
  "webpath": "/opt/focalboard/pack",
  "filespath": "/opt/focalboard/data",
