# HALF — Docker Compose Environment Configuration
# Copy this file to .env and customize for your deployment.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose -f docker/docker-compose.foss.yml --env-file .env up -d
#
# WARNING: Change ALL default passwords before exposing to any network.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL password for the observability stack (LangWatch, Laminar)
HALF_DB_PASSWORD=half_secret

# ─── Grafana ──────────────────────────────────────────────────────────────────
# Grafana admin password (default: admin)
HALF_GRAFANA_PASSWORD=change-me

# ─── LangWatch ────────────────────────────────────────────────────────────────
# NextAuth secret for LangWatch session encryption
# Generate with: openssl rand -base64 32
HALF_LANGWATCH_SECRET=change-me-in-production

# ─── HALF Runtime ─────────────────────────────────────────────────────────────
# Override the default .hale/ working directory
# HALF_HOME=/custom/path/to/half-data

# ─── API Keys (for inference providers) ───────────────────────────────────────
# Set only the provider you use:
# OPENROUTER_API_KEY=sk-or-...
# DEEPSEEK_API_KEY=sk-...
# OPENEAI_API_KEY=...
# CUSTOM_API_KEY=...
