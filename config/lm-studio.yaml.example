# LM Studio Configuration
# LM Studio binds to AMD ROCm for local inference

version: 0.3

models:
  qwen2.5-coder:7b:
    quantization: Q4_K_M
    context_length: 32768
    gpu_layers: -1  # All layers on GPU
    batch_size: 512
    threads: 8

  qwen2.5-coder:1.5b:
    quantization: Q8_0
    context_length: 16384
    gpu_layers: -1
    threads: 4

server:
  host: 127.0.0.1
  port: 1234
  api_key: ""  # Local only — no auth needed
  cors:
    enabled: true
    origins:
      - "http://localhost:1420"  # Tauri dev server
      - "tauri://localhost"

hardware:
  backend: rocm
  device: amd
  memory_pool:
    max_allocation_mb: 15360  # 15GB for 7900 XTX
    reserved_for_os_mb: 2048
  compute:
    use_flash_attn: true
    kv_cache_quantization: true

budget:
  max_tokens_per_minute: 100000
  max_concurrent_requests: 2  # VRAM constraint
